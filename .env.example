# forge-arena environment configuration
# Copy to .env and fill in values. Never commit .env.

# Required: Anthropic API key for agent calls
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Set to "true" to enable demo mode (starts game immediately, skips build checks)
DEMO_MODE=false

# Optional: Set to "true" to use short timers (dungeon_timer=120s, arena_turn_cap=20)
FAST_MODE=false

# Optional: Override game server port (default: 3000)
PORT=3000
